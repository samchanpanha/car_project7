# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/prisma/db/test.db

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# `.env` holds live credentials — keep it out of git and out of the Docker
# build context. `.env.example` is the shareable template.
.env*
!.env.example

# vercel
.vercel

# OCR & temp files
*.traineddata
*.bak*


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
/test
/prompt

server.log
# Skills directory
/skills/

# Docker persistent data volumes
/data/

# Java / Maven build artifacts
target/
**/target/
*.jar
*.war
*.class
.flattened-pom.xml
# Python bytecode (scripts/*.py, .agent/skills/**/scripts)
__pycache__/
**/__pycache__/
*.py[cod]

# Transient runtime artifacts
*.pid
.zscripts/dev.pid

# Agent/tool scratch output (regenerable, never imported by the app)
/tool-results/
