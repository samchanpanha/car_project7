# Dependencies
node_modules
.pnp
.pnp.*

# Next.js build outputs
.next
out
build

# ------------------------------------------------------------
# SECRETS — never bake these into an image layer.
# `COPY . .` in the builder stage previously pulled the tracked .env (live
# Cloudflare R2 keys + Telegram bot token) into the image, where it stays
# readable by anyone who can pull the image, forever.
# All runtime configuration is injected by docker-compose `environment:`.
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.pem

# Git and IDE
.git
.gitignore
.github
.vscode
.idea
.claude
.z-ai-config
.zscripts

# Logs and debug
*.log
dev.log
server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Database & local uploads (mounted via volumes)
db/*.db-wal
db/*.db-shm
uploads/*
!uploads/.gitkeep

# OCR trained data caches
*.traineddata
*.bak*

# ------------------------------------------------------------
# Not part of the frontend image — excluded to shrink the build context.
# The Spring Boot backend is built from its own context (./backend).
# nginx/ and monitoring/ are bind-mounted from the host by docker-compose,
# so they do not need to be inside the image either.
# ------------------------------------------------------------
backend
nginx
monitoring
Caddyfile
render.yaml
docker-compose.yml
Dockerfile

# NOTE: docker-entrypoint.sh must stay in the build context — both the `web`
# and `daemon` stages do `COPY docker-entrypoint.sh /usr/local/bin/`.

# Agent / planning artifacts
.agent
agent-ctx
scratch
tool-results
download
mini-services

# Large planning docs (build context only, never imported by the app)
PLAN.md
worklog.md
ARCHITECTURE_MIGRATION_PLAN.md
PROMOTIONAL_VIDEO_SCRIPTS.md
SYSTEM_USER_GUIDE.md
deploy_note.md

# Misc
.DS_Store
