// KhLan (ខ្លាន) — Cambodia AI-Powered Car Marketplace
// Prisma schema — MVP vertical slice (see PLAN.md §10)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Users & Sellers ----------

model User {
  id            String   @id @default(cuid())
  phone         String   @unique
  email         String?
  name          String
  role          String   @default("BUYER") // BUYER | SELLER | DEALER | ADMIN | SUPER_ADMIN
  locale        String   @default("km") // km | en
  phoneVerified Boolean  @default(false)
  avatarUrl     String?
  passwordHash  String? // scrypt salt:hash — null => OTP/Telegram-only account
  telegramId    String?  @unique // Telegram user id when linked
  telegramUsername String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sellerProfile     SellerProfile?
  vehiclesSold      Vehicle[]        @relation("SellerVehicles")
  favorites         Favorite[]
  conversations     Conversation[]   @relation("BuyerConversations")
  messages          Message[]
  tenantMemberships TenantMember[]
  savedSearches     SavedSearch[]
  buyerAppointments Appointment[]    @relation("BuyerAppointments")
  purchaseRequests  PurchaseRequest[] @relation("BuyerPurchaseRequests")
}

model SellerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  type         String   @default("PRIVATE") // PRIVATE | DEALER
  shopName     String?
  bio          String?
  bioKm        String?
  city         String   @default("Phnom Penh")
  address      String?
  verified     Boolean  @default(false)
  verification String   @default("UNVERIFIED") // UNVERIFIED | PENDING | VERIFIED | REJECTED
  responseRate Int      @default(0) // percent of inquiries answered <24h
  ratingAvg    Float    @default(0) // 0-5
  ratingCount  Int      @default(0)
  memberSince  DateTime @default(now())
  logoUrl      String?
  phone        String?
  telegram     String?
  // ----- Telegram Hub (seller/dealer self-service growth tools) -----
  // The seller's own Telegram Mini App link (any https URL, usually a t.me
  // bot-app link) shown to buyers on listings and the storefront.
  tgMiniAppUrl String?
  // Public Telegram channel link (https://t.me/<channel>) buyers can join.
  tgChannelUrl String?
  // Telegram group chat link (https://t.me/<group> or https://t.me/+hash).
  tgGroupUrl   String?
  // Short unique referral code minted lazily; powers tracked invite links
  // /api/tg/<code> that count buyer clicks before redirecting into Telegram.
  inviteCode   String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])

  inviteEvents TelegramInviteEvent[]
}

// One row per buyer click on a seller's tracked Telegram invite link
// (/api/tg/<code>?d=DEST) — powers the seller's Telegram Hub stats.
model TelegramInviteEvent {
  id        String   @id @default(cuid())
  profileId String
  profile   SellerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  code      String
  // MINIAPP | CHANNEL | GROUP — which destination the click targeted
  dest      String
  createdAt DateTime @default(now())

  @@index([profileId, createdAt])
  @@index([code])
}

// ---------- Tenants (Dealership Organizations) ----------

model Tenant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  logoUrl      String?
  bio          String?
  bioKm        String?
  city         String   @default("Phnom Penh")
  address      String?
  phone        String?
  telegram     String?
  verified     Boolean  @default(false)
  verification String   @default("UNVERIFIED") // UNVERIFIED | PENDING | VERIFIED | REJECTED
  status       String   @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members      TenantMember[]
  vehicles     Vehicle[]
  profiles     SellerProfile[]
  subscription Subscription?
  appointments Appointment[]
  payments     SubscriptionPayment[]
  purchaseRequests PurchaseRequest[]
}

model TenantMember {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String   @default("SALES_STAFF") // OWNER | MANAGER | SALES_STAFF | INVENTORY_MANAGER
  status    String   @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt DateTime @default(now())

  @@unique([tenantId, userId])
}

// ---------- Subscriptions (Monetization) ----------

model Subscription {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  plan             String   @default("FREE") // FREE | BASIC | PRO | ENTERPRISE
  status           String   @default("ACTIVE") // ACTIVE | CANCELLED | PAST_DUE
  billingCycle     String   @default("MONTHLY") // MONTHLY | YEARLY
  priceUsd         Float    @default(0)
  listingsLimit    Int      @default(3)
  featuredLimit    Int      @default(0)
  seats            Int      @default(1)
  startedAt        DateTime @default(now())
  currentPeriodEnd DateTime @default(now())
}

// ---------- Customer Dashboard ----------

model SavedSearch {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  queryJson     String // JSON of VehicleQuery filters
  alertsEnabled Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Appointment {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  buyerId     String
  buyer       User     @relation("BuyerAppointments", fields: [buyerId], references: [id])
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  sellerId    String
  scheduledAt DateTime
  status      String   @default("REQUESTED") // REQUESTED | CONFIRMED | COMPLETED | CANCELLED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------- Subscription Payments (Bakong KHQR / Manual KHQR) ----------

model SubscriptionPayment {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan            String // BASIC | PRO | ENTERPRISE
  billingCycle    String // MONTHLY | YEARLY
  amountUsd       Float
  months          Int // 1 (monthly) | 12 (yearly)
  method          String // BAKONG | MANUAL
  // PENDING (bakong QR issued, awaiting transfer)
  // AWAITING_VERIFICATION (manual request or bakong transfer seen, needs admin)
  // VERIFIED | REJECTED | CANCELLED
  status          String    @default("PENDING")
  reference       String    @unique // platform reference, e.g. PAY-20250101-AB12CD
  bakongMd5       String?   // md5 returned by Bakong generate-qr
  bakongHash      String?   // transaction hash found by check-by-md5
  qrPayload       String?   // EMVCo KHQR payload string (Bakong-issued or admin-configured)
  manualRef       String?   // seller-entered bank transaction reference (manual flow)
  evidenceUrl     String?   // optional payment evidence link (manual flow)
  evidenceImage   String?   // uploaded payment screenshot as a data URL (manual flow)
  telegramSentAt  DateTime? // when the proof was delivered to the admin's Telegram bot
  telegramError   String?   // last Telegram delivery error, when delivery failed
  // Telegram inline-button workflow — tracks the message so the webhook can
  // edit it (remove buttons, add status text) after admin approval/rejection.
  telegramMessageId Int?      // message_id of the proof message in the group
  telegramGroupId   String?   // chat_id where the proof was sent (for edits)
  verifiedByName    String?   // Telegram display name of the admin who approved
  notifiedSeller    Boolean   @default(false) // whether seller was notified of result
  notifiedAt        DateTime? // when the seller notification was sent
  note            String?
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  abaTransactions AbaTransaction[]

  @@index([tenantId])
  @@index([status])
}

// ---------- ABA PayWay / Bank Group Transactions ----------

model AbaTransaction {
  id                    String                @id @default(cuid())
  rawMessage            String                // full text of the Telegram message
  messageId             Int?                  // Telegram message_id in the group
  chatId                String?               // Telegram chat_id (e.g. -1004489863210)
  source                String                @default("ABA_PAYWAY") // ABA_PAYWAY, BAKONG, etc.

  // Parsed fields from ABA PayWay notification:
  trxId                 String                @unique // e.g. "179264913984347"
  apv                   String?               // approval code e.g. "135160"
  amount                Float                 // numeric amount, e.g. 200 or 49.0
  currency              String                // "KHR" or "USD"
  amountUsd             Float                 // normalized to USD for revenue / plan matching
  payerName             String?               // e.g. "Sam Chanpanha"
  payerAccount          String?               // e.g. "*674"
  bankCode              String?               // e.g. "AMRTKHPPXXX"
  merchantName          String?               // e.g. "SAM CHAN PANHA"
  transactionDateRaw    String?               // e.g. "Oct 22, 01:05 PM"
  transactionDate       DateTime              // parsed datetime or message timestamp

  // Matching status with subscription payments:
  status                String                @default("UNMATCHED") // UNMATCHED, MATCHED, MANUAL, AMBIGUOUS
  subscriptionPaymentId String?
  subscriptionPayment   SubscriptionPayment?  @relation(fields: [subscriptionPaymentId], references: [id], onDelete: SetNull)
  matchedAt             DateTime?
  matchedBy             String?               // "AUTO_TRX_ID", "AUTO_APV", "AUTO_AMOUNT_TIME", "MANUAL_ADMIN"

  // Deduplication & Same-Time Verification:
  isDuplicate           Boolean               @default(false) // true if same Trx ID or message was seen again
  duplicateCount        Int                   @default(0)     // count of duplicate delivery attempts
  sameTimeCollision     Boolean               @default(false) // true if another transaction occurred at identical time
  collisionTrxIds       String?               // comma-separated list of colliding Trx IDs
  verificationNote      String?               // verification / collision audit note

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([trxId])
  @@index([status])
  @@index([transactionDate])
  @@index([createdAt])
}

// ---------- Buyer Purchase Requests (vehicle sale workflow) ----------

model PurchaseRequest {
  id           String    @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  buyerId      String
  buyer        User      @relation("BuyerPurchaseRequests", fields: [buyerId], references: [id])
  tenantId     String? // set when the listing belongs to a tenant
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])
  sellerUserId String // vehicle.sellerId — the user who fulfils the sale
  // PENDING | ACCEPTED | COMPLETED | CANCELLED | REJECTED
  status       String    @default("PENDING")
  message      String?
  priceUsd     Float // vehicle price snapshot at request time
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([vehicleId])
  @@index([buyerId])
  @@index([tenantId])
  @@index([status])
}

// ---------- Platform Settings (Super Admin) ----------

model PlatformSetting {
  key       String   @id
  valueJson String
  updatedAt DateTime @updatedAt
}

// ---------- Vehicles ----------

model Vehicle {
  id              String  @id @default(cuid())
  sellerId        String
  seller          User    @relation("SellerVehicles", fields: [sellerId], references: [id])
  // Which real user (or demo persona) actually created the listing — used for
  // "my listings" ownership and edit authorization (sellerId stays the display
  // seller, which may be the shared demo seller for legacy MVP flows).
  createdById     String?
  make            String
  model           String
  variant         String?
  year            Int
  priceUsd        Float
  mileageKm       Int
  transmission    String // AUTOMATIC | MANUAL
  fuel            String // PETROL | DIESEL | HYBRID | ELECTRIC
  engineCc        Int?
  drivetrain      String? // FWD | RWD | AWD
  bodyType        String // SUV | SEDAN | PICKUP | HATCHBACK | VAN | COUPE
  exteriorColor   String?
  condition       String  @default("USED") // LIKE_NEW | USED
  city            String  @default("Phnom Penh")
  district        String?
  description     String?
  descriptionKm   String?
  status          String  @default("PUBLISHED") // DRAFT | PENDING_REVIEW | PUBLISHED | REJECTED | SOLD | ARCHIVED
  featured        Boolean @default(false)
  views           Int     @default(0)
  vinLast6        String? // only last 6 chars stored for privacy
  plateNo         String?
  ownershipCount  Int?
  accidentDeclared String @default("UNKNOWN") // NONE_DECLARED | MINOR_DECLARED | MAJOR_DECLARED | UNKNOWN
  importOrigin    String? // USA | KOREA | JAPAN | THAILAND | DUBAI | LOCAL
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  images        VehicleImage[]
  documents     VehicleDocument[]
  reports       VehicleHistoryReport[]
  favorites     Favorite[]
  conversations Conversation[]
  reportsAbuse  ReportedContent[]
  appointments  Appointment[]
  purchaseRequests PurchaseRequest[]
  tenantId      String?
  tenant        Tenant?          @relation(fields: [tenantId], references: [id])
}

model VehicleImage {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)
}

model VehicleDocument {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  // type: REGISTRATION_BOOK | IMPORT_DECLARATION | SERVICE_RECORD | INSPECTION_CERT | INSURANCE
  type      String
  // status: PROVIDED | MISSING | VERIFIED | REJECTED
  status    String  @default("PROVIDED")
  notes     String?
  fileUrl   String?
}

// ---------- AI Vehicle History Reports ----------

model VehicleHistoryReport {
  id                String   @id @default(cuid())
  vehicleId         String
  vehicle           Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  // JSON array of CheckResult { area, title, titleKm, status, detail, detailKm, source, confidence }
  checksJson        String
  overallConfidence Float    @default(0) // 0-100
  summaryEn         String?
  summaryKm         String?
  // JSON array of limitation strings (en+km pairs)
  limitationsJson   String?
  status            String   @default("COMPLETE") // PENDING | PROCESSING | COMPLETE | FAILED
  requestedBy       String?
  createdAt         DateTime @default(now())
}

// ---------- Engagement ----------

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, vehicleId])
}

model Conversation {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User     @relation("BuyerConversations", fields: [buyerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String? // null => system message
  sender         User?        @relation(fields: [senderId], references: [id])
  body           String
  isSystem       Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model ReportedContent {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  reason    String // SCAM | WRONG_INFO | DUPLICATE | OFFENSIVE | SOLD | OTHER
  details   String?
  status    String   @default("OPEN") // OPEN | REVIEWED | RESOLVED | DISMISSED
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metaJson  String?
  createdAt DateTime @default(now())
}
