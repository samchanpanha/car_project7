# ============================================================================
# KhLan (ឡាន) — environment template
#
# Copy to `.env` and fill in real values:      cp .env.example .env
#
# `.env` is git-ignored and excluded from the Docker build context
# (see .dockerignore) so credentials never land in an image layer or in git.
# docker-compose reads `.env` automatically for `${VAR:-default}` interpolation.
#
# NEVER commit real keys here. Rotate anything that has already been pushed.
# ============================================================================

# ----------------------------------------------------------------------------
# Session signing — THE MOST IMPORTANT VALUE IN THIS FILE
# ----------------------------------------------------------------------------
# Signs and verifies the `khlan_auth` session cookie / JWT.
# The Next.js frontend (src/lib/auth.ts) and the Spring Boot backend
# (SessionTokenService) must BOTH see the same value, or neither can verify the
# other's tokens and real logins silently fail.
# Generate one with:  openssl rand -hex 32
AUTH_SECRET=replace-me-with-openssl-rand-hex-32

# ----------------------------------------------------------------------------
# Demo mode — leave "false" anywhere that is reachable from the internet
# ----------------------------------------------------------------------------
# When true, ANY request may impersonate a demo persona (including usr_admin)
# just by sending the `x-khlan-persona` header or `khlan_persona` cookie — no
# password required. Handy for local demos, catastrophic in production.
APP_DEMO_MODE=false

# ----------------------------------------------------------------------------
# Cron / maintenance triggers (GET /api/cron/**)
# ----------------------------------------------------------------------------
# Callers must send:  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace-me-with-openssl-rand-hex-32

# ----------------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API with credentials.
# Behind the docker-compose NGINX gateway the origin is the gateway itself.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000

# ----------------------------------------------------------------------------
# Database (PostgreSQL 16)
# ----------------------------------------------------------------------------
# Prisma's provider is `postgresql` — a `file:` SQLite URL will NOT work.
# Host `postgres` inside the docker network; `localhost` for host-side tooling.
DATABASE_URL=postgresql://khlan:khlan_secret_2026@localhost:5432/khlandb

# Spring Boot datasource (container-internal hostnames)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/khlandb
SPRING_DATASOURCE_USERNAME=khlan
SPRING_DATASOURCE_PASSWORD=khlan_secret_2026

# ----------------------------------------------------------------------------
# Redis (cache / distributed lock)
# ----------------------------------------------------------------------------
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379

# ----------------------------------------------------------------------------
# Frontend -> backend routing
# ----------------------------------------------------------------------------
# Used by next.config.ts rewrites. Baked in at BUILD time, so it must be the
# container-network address, not localhost.
BACKEND_URL=http://backend:8080

# ----------------------------------------------------------------------------
# Object storage — Cloudflare R2 (primary) / MinIO (local fallback)
# ----------------------------------------------------------------------------
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=cars-storage
CLOUDFLARE_R2_PREFIX=
CLOUDFLARE_R2_PUBLIC_URL=
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_PRIVATE_BUCKET=cars-storage

MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ----------------------------------------------------------------------------
# Telegram bot — subscription payment verification
# ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=KhLanOfficialBot
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=replace-me-with-openssl-rand-hex-32
TELEGRAM_WEBHOOK_URL=
# Backend runs the unified 24/7 poller. Do NOT also run the frontend
# `daemon` Dockerfile target against the same bot token: two getUpdates
# pollers on one token fight each other and drop updates.
TELEGRAM_LOCAL_POLLING=true

# ----------------------------------------------------------------------------
# Nacos — service discovery & config center
# ----------------------------------------------------------------------------
NACOS_SERVER_ADDR=nacos:8848
NACOS_DISCOVERY_ENABLED=true
NACOS_CONFIG_ENABLED=true
